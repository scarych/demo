{
  "compilerOptions": {
    "strict": true,
    "strictPropertyInitialization": false,
    "module": "ESNext",
    "target": "ESNext",
    "moduleResolution": "bundler",
    "experimentalDecorators": true,
    "emitDecoratorMetadata": true,
    "esModuleInterop": true,
    "skipLibCheck": true,
    "types": ["node"],
    "noEmit": true
  },
  "include": ["src"]
}
